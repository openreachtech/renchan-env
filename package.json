{
  "name": "@openreachtech/renchan-env",
  "version": "1.0.6",
  "description": "Env module - Renchan",
  "files": [
    "index.mjs",
    "lib/",
    "scripts/",
    "types/"
  ],
  "main": "index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "node": "./index.js",
      "default": "./index.js"
    },
    "./scripts/*": {
      "import": "./scripts/*.mjs",
      "require": "./scripts/*.js",
      "node": "./scripts/*.js",
      "default": "./scripts/*.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "export NODE_ENV=development; export APP_NAME='App Name Exported in Terminal'; jest --maxWorkers=5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openreachtech/renchan-env.git"
  },
  "keywords": [
    "Renchan"
  ],
  "author": "Open Reach Tech Inc.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/openreachtech/renchan-env/issues"
  },
  "homepage": "https://github.com/openreachtech/renchan-env#readme",
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@openreachtech/eslint-config": "^4.5.0",
    "@openreachtech/jest-constructor-spy": "^1.1.1",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.2",
    "jest": "^30.4.2"
  }
}
